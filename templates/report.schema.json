{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaytestReport",
  "type": "object",
  "required": ["goal_id", "round", "playtester_run_id", "checks"],
  "additionalProperties": false,
  "properties": {
    "goal_id": { "type": "string", "minLength": 1 },
    "round": { "type": "integer", "minimum": 1 },
    "playtester_run_id": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkResult" }
    },
    "ux_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/uxFinding" },
      "description": "Visual and UX review results. Separate from checks: a judged finding can never fail a goal. See reference/ux-review.md."
    },
    "instrumented_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/instrumentedFinding" }
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Relative paths from the round folder to screenshots or log excerpts. Required and must exist on disk when status is pass or fail."
        },
        "action_log_lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "repro": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required when status is fail."
        },
        "user_facing_bug": {
          "type": "string",
          "description": "Required when status is fail. One plain-language sentence describing the user-visible impact."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pass" } } },
          "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "fail" } } },
          "then": {
            "required": ["evidence", "repro", "user_facing_bug"],
            "properties": {
              "evidence": { "minItems": 1 },
              "repro": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "uxFinding": {
      "type": "object",
      "required": ["id", "layer", "severity", "observation", "user_impact", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "enum": ["measured", "judged"] },
        "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "Required for measured findings. The ux_probe.js rule id, e.g. low-legibility."
        },
        "heuristic": {
          "type": "string",
          "minLength": 1,
          "description": "Required for judged findings. One of the named heuristics in reference/ux-review.md."
        },
        "surface": {
          "type": "string",
          "description": "Route, screen, or component the finding applies to."
        },
        "selector": { "type": "string" },
        "viewport": {
          "type": "integer",
          "minimum": 1,
          "description": "Viewport width in CSS pixels the finding was observed at."
        },
        "observation": { "type": "string", "minLength": 1 },
        "user_impact": { "type": "string", "minLength": 1 },
        "rationale": {
          "type": "string",
          "description": "Required for judged findings. Why the observation causes the impact."
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Required for judged findings."
        },
        "measurement": {
          "$ref": "#/$defs/uxMeasurement",
          "description": "Required for measured findings."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "proposed_check": {
          "type": ["string", "null"],
          "description": "Candidate observable statement for a FUTURE goal.json. Never added to the frozen current one."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "layer": { "const": "measured" } } },
          "then": { "required": ["rule", "measurement"] }
        },
        {
          "if": { "properties": { "layer": { "const": "judged" } } },
          "then": {
            "required": ["heuristic", "rationale", "confidence"],
            "properties": { "severity": { "enum": ["major", "minor"] } }
          }
        }
      ]
    },
    "uxMeasurement": {
      "type": "object",
      "required": ["metric", "actual", "threshold", "unit"],
      "additionalProperties": true,
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "actual": { "type": "number" },
        "threshold": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "approximated": {
          "type": "boolean",
          "description": "True when the measurement sat on an image or gradient background and needs visual confirmation."
        }
      }
    },
    "instrumentedFinding": {
      "type": "object",
      "required": ["id", "observation", "source", "clean_rerun_reproduced"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["console", "network", "runtime-injection", "temp-log"] },
        "visible_symptom": { "type": ["string", "null"] },
        "clean_rerun_reproduced": { "type": "boolean" },
        "proposed_check": { "type": ["string", "null"] }
      }
    }
  }
}
